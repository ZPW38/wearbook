<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!-- 内置文件管理器需要读取设备上的图书文件（不调用系统选择器） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 11+ 分区存储：光有 READ_EXTERNAL_STORAGE 时 File.listFiles() 只会返回音乐/图片等
         媒体文件，电子书（epub/txt/pdf…）会被系统过滤掉，必须「所有文件访问」才能正常浏览 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />


    <!-- 链接导入：把一个 http(s) 直链下载成书。
         只有"直链"能用 —— 需要登录 / 验证码 / 绕过访问控制才能拿到的内容，这里同样下不到，
         这是刻意的边界，见 data/UrlImport.kt 的说明 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 朗读 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        tools:targetApi="q"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/Theme.WearBook">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 其他 App 里「打开方式」选腕上书（epub/mobi 这类格式基本没人抢） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- BROWSABLE 是给"从浏览器点链接打开"用的，这里只处理本地文件，
                     留着会让 lint 报 Missing URL（有 BROWSABLE 却没声明 scheme/host） -->
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
            </intent-filter>

            <!-- 其他 App 里「分享」给腕上书：不需要任何存储权限也能导入 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
